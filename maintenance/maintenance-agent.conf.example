# /etc/maintenance-agent.conf -- per-host maintenance policy

HOST_LABEL="phx-arm"

# A fresh successful backup is mandatory before any package/image update.
BACKUP_COMMAND="/usr/local/bin/backup-agent.sh"

# Create a separate monthly Push monitor in Uptime Kuma.
MAINTENANCE_KUMA_PUSH_URL="http://<unraid-ip>:3001/api/push/<maintenance-token>"

UPDATE_SYSTEM=true
UPDATE_OPENLITESPEED="auto"
UPDATE_DOCKER_COMPOSE=true
AUTO_REBOOT=true
REBOOT_DELAY_MINUTES=2

HEALTH_TIMEOUT_SECONDS=180
HTTP_CHECK_TIMEOUT_SECONDS=20

# Explicit allowlist. These must be the authoritative Compose projects used
# to deploy the services. Do NOT list docker-compose.yml files generated by
# backup-agent.sh/docker-autocompose solely for disaster recovery.
COMPOSE_PROJECT_DIRS=(
  # "/opt/stacks/example"
)

# Public/local endpoints that must work before maintenance is considered a
# success. curl follows redirects and accepts HTTP 2xx/3xx responses.
HEALTHCHECK_URLS=(
  # "https://example.com/"
)

# Reuses PUSHOVER_USER/PUSHOVER_TOKEN from /etc/backup-agent/secrets.env.
PUSHOVER_NOTIFY_SUCCESS=true


