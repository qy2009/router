discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { host = sys.env("ALLOY_HOST"), job = "docker" }
  forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
  stage.docker { }
  forward_to = [loki.write.central.receiver]
}

loki.source.journal "systemd" {
  path       = "/var/log/journal"
  max_age    = "24h"
  labels     = { host = sys.env("ALLOY_HOST"), job = "systemd" }
  forward_to = [loki.write.central.receiver]
}

loki.source.file "script_logs" {
  targets = [
    {
      __path__ = "/var/log/host/backup-agent.log",
      host = sys.env("ALLOY_HOST"),
      job = "script",
      script = "backup-agent",
    },
    {
      __path__ = "/var/log/host/maintenance-agent.log",
      host = sys.env("ALLOY_HOST"),
      job = "script",
      script = "maintenance-agent",
    },
  ]
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "http://100.111.111.118:3100/loki/api/v1/push"
  }
}
