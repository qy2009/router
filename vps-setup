#!/bin/bash
# =============================================================
# Debian Server Setup Script
# - Install curl & sudo
# - Change SSH port to 6622
# - Enable root SSH login
# - Enable password authentication
# - Install & configure fail2ban
# =============================================================

set -e  # Exit immediately on error

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log()    { echo -e "${GREEN}[+]${NC} $1"; }
warn()   { echo -e "${YELLOW}[!]${NC} $1"; }
error()  { echo -e "${RED}[x]${NC} $1"; exit 1; }

# Must be run as root
if [ "$EUID" -ne 0 ]; then
  error "Please run as root: sudo bash debian-setup.sh"
fi

# -------------------------------------------------------------
# 1. Install curl and sudo
# -------------------------------------------------------------
log "Updating package lists..."
apt-get update -qq

log "Installing curl and sudo..."
apt-get install -y curl sudo

# -------------------------------------------------------------
# 2. Configure SSH
# -------------------------------------------------------------
SSHD_CONFIG="/etc/ssh/sshd_config"

log "Backing up sshd_config to /etc/ssh/sshd_config.bak..."
cp "$SSHD_CONFIG" "${SSHD_CONFIG}.bak"

log "Setting SSH port to 6622..."
sed -i 's/^#*Port .*/Port 6622/' "$SSHD_CONFIG"
grep -q "^Port " "$SSHD_CONFIG" || echo "Port 6622" >> "$SSHD_CONFIG"

log "Enabling root SSH login..."
sed -i 's/^#*PermitRootLogin .*/PermitRootLogin yes/' "$SSHD_CONFIG"
grep -q "^PermitRootLogin " "$SSHD_CONFIG" || echo "PermitRootLogin yes" >> "$SSHD_CONFIG"

log "Enabling password authentication..."
sed -i 's/^#*PasswordAuthentication .*/PasswordAuthentication yes/' "$SSHD_CONFIG"
grep -q "^PasswordAuthentication " "$SSHD_CONFIG" || echo "PasswordAuthentication yes" >> "$SSHD_CONFIG"

log "Verifying SSH config changes..."
sshd -T | grep -E "^(port|permitrootlogin|passwordauthentication)"

# -------------------------------------------------------------
# 3. Open port 6622 in firewall (UFW or iptables)
# -------------------------------------------------------------
if command -v ufw &>/dev/null; then
  log "Opening port 6622 in UFW..."
  ufw allow 6622/tcp
  ufw reload
else
  log "UFW not found, using iptables to open port 6622..."
  iptables -A INPUT -p tcp --dport 6622 -j ACCEPT
fi

# -------------------------------------------------------------
# 4. Restart SSH service
# -------------------------------------------------------------
log "Restarting SSH service..."
systemctl restart sshd

# -------------------------------------------------------------
# 5. Install and configure fail2ban
# -------------------------------------------------------------
log "Installing fail2ban..."
apt-get install -y fail2ban

log "Configuring fail2ban for SSH on port 6622..."
cat > /etc/fail2ban/jail.d/sshd.local << 'JAIL'
[sshd]
enabled = true
port = 6622
maxretry = 5
bantime = 3600
findtime = 600
JAIL

log "Enabling and starting fail2ban..."
systemctl enable fail2ban
systemctl restart fail2ban

# -------------------------------------------------------------
# Done
# -------------------------------------------------------------
echo ""
echo -e "${GREEN}============================================${NC}"
echo -e "${GREEN}  Setup complete! Summary:${NC}"
echo -e "${GREEN}============================================${NC}"
echo -e "  ${GREEN}✔${NC} curl & sudo installed"
echo -e "  ${GREEN}✔${NC} SSH port changed to 6622"
echo -e "  ${GREEN}✔${NC} Root SSH login enabled"
echo -e "  ${GREEN}✔${NC} Password authentication enabled"
echo -e "  ${GREEN}✔${NC} fail2ban installed & configured"
echo ""
warn "IMPORTANT: Test SSH on port 6622 BEFORE closing this session!"
echo -e "  ssh -p 6622 root@YOUR_SERVER_IP"
echo ""
warn "If on Oracle Cloud: open port 6622 in OCI Security List too."
echo ""
